# ────────────────────────────────────────────────
#  ROOT GITIGNORE — Portfolio repo
#  (frontend/ has its own .gitignore; this covers
#   the backend, the Python venv, and OS clutter.)
# ────────────────────────────────────────────────

# Python / FastAPI backend
backend/__pycache__/
__pycache__/
*.py[cod]
*$py.class

# Environment files
.env
.env.*
!.env.example

# Python virtual environment
myworld/

# Node / build artifacts (belt-and-suspenders for frontend)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?